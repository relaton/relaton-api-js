{
  "name": "relaton-api contract fixtures",
  "description": "Executable contract (TODO.api/12): every fixture is a GET against a base URL. Assertions are the stable contract surface only — status, headers, and pinned identifiers — never titles or dates, which drift with the datasets.",
  "baseUrlEnv": "RELATON_API_BASE_URL",
  "fixtures": [
    {
      "name": "document: RFC 8446 resolves in the rfcs flavor",
      "path": "/api/v1/document?code=RFC%208446",
      "headers": { "accept": "text/xml" },
      "expect": {
        "status": 200,
        "contentType": "text/xml",
        "bodyContains": ["<bibdata", "<docidentifier type=\"IETF\" primary=\"true\">RFC 8446"]
      }
    },
    {
      "name": "document: the STD sub-series spelling crosses to its RFC record",
      "path": "/api/v1/document?code=STD%2086",
      "headers": { "accept": "text/xml" },
      "expect": {
        "status": 200,
        "contentType": "text/xml",
        "bodyContains": ["<docidentifier type=\"IETF\" primary=\"true\">STD 86"]
      }
    },
    {
      "name": "document: a bare 3GPP id resolves to the latest release",
      "path": "/api/v1/document?code=3GPP%20TR%2000.01U",
      "headers": { "accept": "text/xml" },
      "expect": {
        "status": 200,
        "contentType": "text/xml",
        "bodyContains": ["<bibdata"]
      }
    },
    {
      "name": "document: the dataset alias spelling of an iana registry resolves",
      "path": "/api/v1/document?code=IANA%20rpki-signed-objects",
      "headers": { "accept": "text/xml" },
      "expect": {
        "status": 200,
        "contentType": "text/xml",
        "bodyContains": ["<bibdata"]
      }
    },
    {
      "name": "document: a copublished ISO/IEC id resolves undated to its latest edition",
      "path": "/api/v1/document?code=ISO%2FIEC%2027001",
      "headers": { "accept": "text/xml" },
      "expect": {
        "status": 200,
        "contentType": "text/xml",
        "bodyContains": ["<docidentifier type=\"ISO\" primary=\"true\">ISO/IEC 27001:2022"]
      }
    },
    {
      "name": "document: an ETSI versioned id resolves from its bare form",
      "path": "/api/v1/document?code=ETSI%20SR%20000%20314",
      "headers": { "accept": "text/xml" },
      "expect": {
        "status": 200,
        "contentType": "text/xml",
        "bodyContains": ["<docidentifier type=\"ETSI\" primary=\"true\">ETSI SR 000 314 V2.39.1 (2026-03)"]
      }
    },
    {
      "name": "document: an unknown code is a 404, not an error page",
      "path": "/api/v1/document?code=NOSUCHXX99",
      "headers": { "accept": "text/xml" },
      "expect": {
        "status": 404,
        "contentType": "text/plain"
      }
    },
    {
      "name": "search: Cyrillic identifiers are queryable",
      "path": "/api/v1/search?q=%D0%93%D0%9E%D0%A1%D0%A2",
      "headers": { "accept": "application/json" },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "json": { "total": ">0" }
      }
    },
    {
      "name": "search: component filters narrow within a flavor",
      "path": "/api/v1/search?publisher=ISO&number=27001",
      "headers": { "accept": "application/json" },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "json": { "total": ">0" }
      }
    },
    {
      "name": "version: the release banner answers",
      "path": "/api/v1/version",
      "headers": { "accept": "text/plain" },
      "expect": {
        "status": 200,
        "contentType": "text/plain",
        "bodyContains": ["Release:"]
      }
    }
  ]
}
