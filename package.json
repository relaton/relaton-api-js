{
  "name": "api.relaton.org-workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "npm run test:lib && vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply api-relaton-org --local",
    "db:migrate:remote": "wrangler d1 migrations apply api-relaton-org --remote",
    "test:lib": "npm test --workspace relaton-ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.0",
    "@relaton/api": "*",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.3",
    "hono": "^4.13.2",
    "js-yaml": "^5.3.0",
    "pubid-ts": "*",
    "zod": "^4.4.3",
    "relaton-ts": "*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
